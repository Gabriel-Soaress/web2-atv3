generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Emprestimo {
  id                    String    @id @default(uuid())
  tituloItem            String    @map("titulo_item")
  tipoItem              String    @default("LIVRO") @map("tipo_item")
  usuarioNome           String    @map("usuario_nome")
  dataReserva           DateTime  @default(now()) @map("data_reserva")
  dataRetirada          DateTime? @map("data_retirada")
  dataPrevistaDevolucao DateTime? @map("data_prevista_devolucao")
  dataDevolucao         DateTime? @map("data_devolucao")
  status                String    @default("RESERVADO")
  renovacoesCount       Int       @default(0) @map("renovacoes_count")
  temAvaria             Boolean   @default(false) @map("tem_avaria")
  descricaoAvaria       String?   @map("descricao_avaria")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime? @updatedAt @map("updated_at")

  @@map("web2_A1_emprestimos")
}